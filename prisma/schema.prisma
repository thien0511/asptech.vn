generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  INTERNAL_VIEWER
  PRODUCT_EDITOR
  CONTENT_APPROVER
  USER_ADMIN
  SYSTEM_ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
  PENDING
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

enum Visibility {
  PUBLIC
  INTERNAL
  RESTRICTED
}

model User {
  id                 String      @id @default(cuid())
  name               String?
  email              String      @unique
  emailVerified      DateTime?
  image              String?
  passwordHash       String?
  organization       String?
  role               Role        @default(CUSTOMER)
  status             UserStatus  @default(PENDING)
  mustChangePassword Boolean     @default(false)
  accessExpiresAt    DateTime?
  sessionVersion     Int         @default(0)
  lastLoginAt        DateTime?
  accounts           Account[]
  sessions           Session[]
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  @@index([role])
  @@index([status])
  @@index([organization])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime
  @@id([identifier, token])
}

model ProductGroup {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  sortOrder Int       @default(0)
  products  Product[]
}

model Manufacturer {
  id       String    @id @default(cuid())
  name     String    @unique
  country  String?
  website  String?
  products Product[]
}

model PageVisit {
  id        String   @id @default(cuid())
  path      String   @unique
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id                    String         @id @default(cuid())
  code                  String         @unique
  slug                  String         @unique
  name                  String
  model                 String
  summary               String
  description           String
  supplierName          String?
  contactPerson         String?
  sourceWebsite         String?
  sourceDocumentFolder  String?
  sourceImageSpecFolder String?
  sourceUpdatedAt       DateTime?
  legacyExcelStt        Int?
  status                ContentStatus  @default(DRAFT)
  visibility            Visibility     @default(INTERNAL)
  featured              Boolean        @default(false)
  groupId               String
  manufacturerId        String?
  group                 ProductGroup   @relation(fields: [groupId], references: [id])
  manufacturer          Manufacturer?  @relation(fields: [manufacturerId], references: [id])
  specifications Specification[]
  assets         Asset[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  @@index([status, visibility])
  @@index([groupId])
  @@index([manufacturerId])
  @@unique([model, manufacturerId])
}

model Specification {
  id         String     @id @default(cuid())
  productId  String
  name       String
  value      String
  unit       String?
  visibility Visibility @default(INTERNAL)
  sortOrder  Int        @default(0)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Asset {
  id         String     @id @default(cuid())
  productId  String
  title      String
  storageKey String     @unique
  fileName   String
  mimeType   String
  size       Int
  visibility Visibility @default(INTERNAL)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime   @default(now())
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entity     String
  entityId   String?
  result     String
  ipAddress  String?
  metadata   Json?
  createdAt  DateTime @default(now())
  @@index([createdAt])
  @@index([actorId])
}
